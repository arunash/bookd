# ── book-d local config ─────────────────────────────────────────────────────
# Copy to .env (the setup wizard does this for you: `npm run setup`).
# Never commit .env. Secrets marked GENERATED are created for you by the wizard.

# ── Core (required) ──────────────────────────────────────────────────────────
# Local SQLite file — the entire datastore. No cloud DB.
DATABASE_URL="file:./dev.db"

# 32-byte base64 key that encrypts all PII/PHI at rest (AES-256-GCM). GENERATED.
# Losing this makes existing encrypted rows unreadable. Back it up.
ENCRYPTION_KEY=""

# NextAuth session secret. GENERATED.
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# The single user who owns this instance (gates sign-in).
BOOKED_OWNER_EMAIL="you@example.com"

# ── Voice (required to place real calls) ─────────────────────────────────────
# From your Vapi dashboard (https://vapi.ai). The agent's LLM/STT/TTS run inside
# Vapi; you configure model keys there. book-d only needs these two:
VAPI_API_KEY=""
VAPI_PHONE_NUMBER_ID=""

# Your own cell in E.164 — where the agent patches YOU in when a human is needed
# (the transferCall hand-off). Strongly recommended.
USER_CELL_PHONE=""

# ── Optional ─────────────────────────────────────────────────────────────────
# Anthropic key — used to parse free-text booking requests into structured form.
# Optional: you can also create requests via the portal form without it.
ANTHROPIC_API_KEY=""

# Secret protecting the /api/cron/retries endpoint (auto-retry scheduler). GENERATED.
CRON_SECRET=""

# LOCAL MODE: leave PUBLIC_BASE_URL blank. Without a public URL, book-d does NOT
# register a Vapi webhook and instead POLLS the Vapi API for call outcomes — so
# no ngrok/tunnel is needed. Set this only when deploying somewhere public.
PUBLIC_BASE_URL=""
VAPI_WEBHOOK_SECRET=""

# Google Calendar sign-in (optional; leave blank to use email-only owner gate).
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# WhatsApp channel (optional; off by default).
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""
# App Secret from Meta — verifies inbound webhook signatures (required if WhatsApp is public).
WHATSAPP_APP_SECRET=""
